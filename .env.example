# Copy to .env and fill in your own values. Never commit real secrets.

# Neon / PostgreSQL pooled connection (runtime queries)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Direct (non-pooled) connection for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Better Auth — use a unique random secret with at least 32 characters.
BETTER_AUTH_SECRET="replace_with_a_long_random_secret"
BETTER_AUTH_URL="http://localhost:3000"

# Twelve Data live Forex price provider — get a key at https://twelvedata.com
TWELVE_DATA_API_KEY="your_twelve_data_api_key"

# Groq (free) — powers the Urdu voice assistant on Quick Signals. Get a free key
# (no credit card) at https://console.groq.com/keys. Optional: without it the
# assistant falls back to built-in scripted Urdu replies.
GROQ_API_KEY="your_groq_api_key"

# Admin panel login
ADMIN_PASSWORD="replace_with_a_unique_password_at_least_12_chars"
ADMIN_SESSION_SECRET="replace_with_a_unique_random_secret_at_least_32_chars"
